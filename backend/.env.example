# 로컬 시연용 환경변수. 이 파일을 .env 로 복사해 키를 넣으면 bootRun 이 읽는다. .env 는 커밋하지 않는다.
CORS_ORIGINS=http://localhost:3000
YOUTHCENTER_ENABLED=false
YOUTHCENTER_API_KEY=
# 연습 대화·문의 문장 AI. OPENAI_API_KEY 는 아래 RAG 임베딩과 같이 쓴다.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# 선택. 추론 모델의 생각 분량(minimal·low 등). gpt-5.4-mini 는 비워 둬도 1초대로 답한다. gpt-5-mini 는 minimal 이 아니면 7초 안팎으로 느리다.
OPENAI_REASONING_EFFORT=

# 로컬 아바타 영상 연습 (실시간 영상 및 음성 합성에 사용량이 발생할 수 있음)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SYNTHESIA_API_KEY=
SYNTHESIA_AVATAR_ID=

# RAG는 opt-in. docs/rag/runbook.md 참고. 실제 키/비밀번호는 .env에만 저장한다.
RAG_ENABLED=false
RAG_DB_URL=jdbc:postgresql://localhost:5433/onestep_rag
RAG_DB_USER=onestep
RAG_DB_PASSWORD=
RAG_ADMIN_TOKEN=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_SYNC_ENABLED=false
